# Copy this file to .env and adjust values as needed.
# Never commit the real .env file -- it is already in .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=exoplanet
POSTGRES_PASSWORD=exoplanet
POSTGRES_DB=exoplanet_hunter

# --- Backend (FastAPI) ---
# Full SQLAlchemy URL; only used when running the backend outside Docker
# Compose (Compose injects its own value pointing at the postgres service).
DATABASE_URL=postgresql+psycopg://exoplanet:exoplanet@localhost:5432/exoplanet_hunter
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Next.js) ---
# Must be reachable from the *browser*, not just the backend container --
# use localhost here even though Compose's internal hostname is "backend".
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- External data sources (used starting Phase 2) ---
# MAST_API_TOKEN=
